{
  "name": "@mandate/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Temporal worker: operation workflows and the activities that call upstream systems.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@mandate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration",
    "start": "node dist/main.js",
    "record-history": "tsx --conditions=@mandate/source scripts/record-history.ts"
  },
  "devDependencies": {
    "@mandate/magento2-catalog": "workspace:*",
    "@mandate/testing": "workspace:*",
    "@opentelemetry/otlp-transformer": "0.223.2",
    "@temporalio/testing": "1.26.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@mandate/adapters": "workspace:*",
    "@mandate/config": "workspace:*",
    "@mandate/connector-sdk": "workspace:*",
    "@mandate/core": "workspace:*",
    "@mandate/db": "workspace:*",
    "@mandate/temporal": "workspace:*",
    "@mandate/upstream": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-prometheus": "0.223.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/interceptors-opentelemetry": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "nodemailer": "10.6.0",
    "pino": "10.4.0"
  }
}
