{
  "name": "@aiops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS process: MCP endpoint, policy checks, change-set creation, REST API for trusted pages.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aiops": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@aiops/gitea-issues": "workspace:*",
    "@aiops/magento2-catalog": "workspace:*",
    "@aiops/testing": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "@modelcontextprotocol/ext-tasks": "0.2.3",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "unplugin-swc": "2.0.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@aiops/adapters": "workspace:*",
    "@aiops/config": "workspace:*",
    "@aiops/connector-sdk": "workspace:*",
    "@aiops/core": "workspace:*",
    "@aiops/db": "workspace:*",
    "@aiops/temporal": "workspace:*",
    "@aiops/upstream": "workspace:*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/interceptors-opentelemetry": "1.25.0",
    "fflate": "0.8.3",
    "jose": "6.2.17",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
