{
  "name": "@aiops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS process: MCP endpoint, policy checks, change-set creation, REST API for trusted pages.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@aiops/testing": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "unplugin-swc": "2.0.0"
  },
  "dependencies": {
    "@aiops/config": "workspace:*",
    "@aiops/core": "workspace:*",
    "@aiops/db": "workspace:*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "jose": "6.2.17",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
