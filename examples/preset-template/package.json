{
  "name": "@mandate-examples/preset-template",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Template for a preset: one read, one per-record write, a vendored spec and a contract test.",
  "license": "Apache-2.0",
  "mandate": {
    "preset": "preset.yaml",
    "sdk": "^1.2.0"
  },
  "files": [
    "preset.yaml",
    "spec",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "devDependencies": {
    "@mandate/adapters": "workspace:*",
    "@mandate/config": "workspace:*",
    "@mandate/connector-sdk": "workspace:*",
    "@mandate/core": "workspace:*",
    "@mandate/testing": "workspace:*"
  }
}
