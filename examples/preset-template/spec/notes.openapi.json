{
  "openapi": "3.0.3",
  "info": { "title": "Notes API (template)", "version": "1.0.0" },
  "paths": {
    "/notes": {
      "get": {
        "operationId": "notesList",
        "summary": "List notes",
        "parameters": [
          { "name": "ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated note ids." },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Title contains." },
          { "name": "page_size", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Notes", "content": { "application/json": { "schema": { "type": "object" } } } } }
      },
      "post": {
        "operationId": "notesCreate",
        "summary": "Create a note",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" } }, "required": ["id", "title"] }
            }
          }
        },
        "responses": { "201": { "description": "The note" } }
      }
    },
    "/attachments": {
      "post": {
        "operationId": "attachmentsCreate",
        "summary": "Attach a file (base64) to a note",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "note_id": { "type": "string" }, "content": { "type": "string", "format": "byte" } }, "required": ["note_id", "content"] }
            }
          }
        },
        "responses": { "201": { "description": "The attachment" } }
      }
    },
    "/notes/{id}": {
      "patch": {
        "operationId": "notesUpdate",
        "summary": "Change fields of one note",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "title": { "type": "string" } } } } } },
        "responses": { "200": { "description": "The note" } }
      },
      "delete": {
        "operationId": "notesDelete",
        "summary": "Delete one note",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Deleted" } }
      }
    }
  }
}
