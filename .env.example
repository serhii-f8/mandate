# Development defaults for `docker compose up` (ADR 0012). Copy to `.env` to change them.
# Every value here is a development-only fake. Never commit a real secret; `.env` is git-ignored.

# Host ports (bound to 127.0.0.1)
AIOPS_API_PORT=8400
AIOPS_KEYCLOAK_PORT=8480
AIOPS_TEMPORAL_PORT=17233
AIOPS_POSTGRES_PORT=15432

# Public URLs
AIOPS_KEYCLOAK_PUBLIC_URL=http://localhost:8480
AIOPS_MCP_RESOURCE=http://localhost:8400/mcp
AIOPS_PUBLIC_URL=http://localhost:8400

# Development-only secrets: replace both for any real installation.
# Web client secret for trusted-page login.
AIOPS_WEB_CLIENT_SECRET=dev-only-web-client-secret
# Credential vault master keys, "<id>:<base64 of 32 bytes>", comma-separated.
AIOPS_MASTER_KEYS=1:ZGV2LW9ubHktbWFzdGVyLWtleS0wMTIzNDU2Nzg5YWI=

# PostgreSQL roles
POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres-password
AIOPS_DB_PASSWORD=dev-only-aiops-db-password
TEMPORAL_DB_PASSWORD=dev-only-temporal-db-password
KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db-password

# Keycloak bootstrap administrator
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password

# Keycloak client registration (AUTH-8, ADR 0014): CIMD trusted domains, anonymous DCR switch
AIOPS_CIMD_CLIENT_DOMAINS=claude.ai
AIOPS_CIMD_EXTRA_DOMAINS=localhost,127.0.0.1
AIOPS_DCR=off
AIOPS_DCR_REDIRECT_HOSTS=claude.ai,chatgpt.com,localhost,127.0.0.1

# api
API_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=info
# Trusted-page sessions: lifetime, and how recent a login must be to store a credential (SEC-8).
AIOPS_SESSION_MAX_AGE_SECONDS=28800
AIOPS_FRESH_AUTH_SECONDS=300
# How long a write call without the Tasks extension waits for its preparation (ms, 0..300000).
AIOPS_PREPARE_WAIT_MS=20000
# The web bundle (AIOPS_WEB_DIR=/app/web), the widget bundles (AIOPS_WIDGET_DIR=/app/widgets) and
# presets (AIOPS_PRESET_DIRS=/app/presets) are built into the api image; Compose sets all three.

# Magento sandbox for the Phase 3 acceptance and the preset recordings (deploy/sandbox/magento)
AIOPS_MAGENTO_PORT=4390

# worker and api (both talk to Temporal; Compose sets TEMPORAL_ADDRESS)
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aiops-operations
# Temporal payload encryption keys (SEC-4), "<version>:<base64 of 32 bytes>", comma-separated;
# the highest version encrypts. Development-only fake: replace for any real installation.
AIOPS_TEMPORAL_KEYS=1:ZGV2LW9ubHktdGVtcG9yYWwta2V5LTAxMjM0NTY3ODk=
# The worker shares DATABASE_URL, the configuration, AIOPS_MASTER_KEYS and the presets with api
# (Compose sets them). Optional activity tuning, set only with a value (an empty one is rejected):
# AIOPS_PREPARE_TIMEOUT_MS=3600000 (ceiling of one preparation, > 60000)
# AIOPS_BATCH_HEARTBEAT_MS=30000 (> 10000) AIOPS_BATCH_TIMEOUT_MS=900000 AIOPS_BATCH_MAX_ATTEMPTS=10
# AIOPS_RETRY_INITIAL_MS=1000 AIOPS_RETRY_MAX_MS=30000
# Audit retention archives (AUD-7), worker and api CLI: an absolute path, writable, backed up.
# Compose sets /var/lib/aiops/audit-archive (volume audit-archive); unset, retention refuses.
# AIOPS_AUDIT_ARCHIVE_DIR=/var/lib/aiops/audit-archive

# worker notification settings (NTF-1). Mailpit is the development mail sink only (web UI and API on
# AIOPS_MAILPIT_PORT); production points AIOPS_SMTP_URL at a real relay.
AIOPS_MAILPIT_PORT=8025
AIOPS_SMTP_URL=smtp://mailpit:1025
AIOPS_MAIL_FROM=aiops@example.test
