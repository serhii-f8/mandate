# Development defaults for `docker compose up` (ADR 0012). Copy to `.env` to change them.
# Every value here is a development-only fake. Never commit a real secret; `.env` is git-ignored.

# Host ports (bound to 127.0.0.1)
MANDATE_API_PORT=8400
MANDATE_KEYCLOAK_PORT=8480
MANDATE_TEMPORAL_PORT=17233
MANDATE_POSTGRES_PORT=15432

# Public URLs
MANDATE_KEYCLOAK_PUBLIC_URL=http://localhost:8480
MANDATE_MCP_RESOURCE=http://localhost:8400/mcp
MANDATE_PUBLIC_URL=http://localhost:8400

# Development-only secrets: replace both for any real installation.
# Web client secret for trusted-page login.
MANDATE_WEB_CLIENT_SECRET=dev-only-web-client-secret
# Credential vault master keys, "<id>:<base64 of 32 bytes>", comma-separated.
MANDATE_MASTER_KEYS=1:ZGV2LW9ubHktbWFzdGVyLWtleS0wMTIzNDU2Nzg5YWI=

# PostgreSQL roles
POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres-password
MANDATE_DB_PASSWORD=dev-only-mandate-db-password
TEMPORAL_DB_PASSWORD=dev-only-temporal-db-password
KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db-password

# Keycloak bootstrap administrator
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password

# Keycloak client registration (AUTH-8, ADR 0014): CIMD trusted domains, anonymous DCR switch
MANDATE_CIMD_CLIENT_DOMAINS=claude.ai
MANDATE_CIMD_EXTRA_DOMAINS=localhost,127.0.0.1
MANDATE_DCR=off
MANDATE_DCR_REDIRECT_HOSTS=claude.ai,chatgpt.com,localhost,127.0.0.1
# Service-account clients created by the bootstrap (AUTH-4); empty this in production
MANDATE_KEYCLOAK_SERVICE_ACCOUNTS=mandate-sa-ci

# api
API_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=info
# Trusted-page sessions: lifetime, and how recent a login must be to store a credential (SEC-8).
MANDATE_SESSION_MAX_AGE_SECONDS=28800
MANDATE_FRESH_AUTH_SECONDS=300
# How long a write call without the Tasks extension waits for its preparation (ms, 0..300000).
MANDATE_PREPARE_WAIT_MS=20000
# Proxy hops in front of the api whose X-Forwarded-For is trusted for client addresses (SEC-10,
# integer 0..10). 0 trusts none; set 1 behind one reverse proxy. Never more hops than you run.
# MANDATE_TRUST_PROXY=0
# The web bundle (MANDATE_WEB_DIR=/app/web), the widget bundles (MANDATE_WIDGET_DIR=/app/widgets) and
# presets (MANDATE_PRESET_DIRS=/app/presets) are built into the api image; Compose sets all three.

# Magento sandbox for the Phase 3 acceptance and the preset recordings (deploy/sandbox/magento)
MANDATE_MAGENTO_PORT=4390

# worker and api (both talk to Temporal; Compose sets TEMPORAL_ADDRESS)
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mandate-operations
# Temporal payload encryption keys (SEC-4), "<version>:<base64 of 32 bytes>", comma-separated;
# the highest version encrypts. Development-only fake: replace for any real installation.
MANDATE_TEMPORAL_KEYS=1:ZGV2LW9ubHktdGVtcG9yYWwta2V5LTAxMjM0NTY3ODk=
# The worker shares DATABASE_URL, the configuration, MANDATE_MASTER_KEYS and the presets with api
# (Compose sets them). Optional activity tuning, set only with a value (an empty one is rejected):
# MANDATE_PREPARE_TIMEOUT_MS=3600000 (ceiling of one preparation, > 60000)
# MANDATE_BATCH_HEARTBEAT_MS=30000 (> 10000) MANDATE_BATCH_TIMEOUT_MS=900000 MANDATE_BATCH_MAX_ATTEMPTS=10
# MANDATE_RETRY_INITIAL_MS=1000 MANDATE_RETRY_MAX_MS=30000
# Audit retention archives (AUD-7), worker and api CLI: an absolute path, writable, backed up.
# Compose sets /var/lib/mandate/audit-archive (volume audit-archive); unset, retention refuses.
# MANDATE_AUDIT_ARCHIVE_DIR=/var/lib/mandate/audit-archive

# worker notification settings (NTF-1). Mailpit is the development mail sink only (web UI and API on
# MANDATE_MAILPIT_PORT); production points MANDATE_SMTP_URL at a real relay.
MANDATE_MAILPIT_PORT=8025
MANDATE_SMTP_URL=smtp://mailpit:1025
MANDATE_MAIL_FROM=mandate@example.test

# Observability (NFR-11, NFR-12). OTLP/HTTP trace endpoint of api and worker;
# empty: no trace export; with `--profile observability` set `http://jaeger:4318`
OTEL_EXPORTER_OTLP_ENDPOINT=
# Host port of the Jaeger UI (profile observability only, bound to 127.0.0.1)
MANDATE_JAEGER_PORT=16686
# Metrics (not published): api on 9464 (MANDATE_METRICS_PORT), worker on 8081 (MANDATE_WORKER_HTTP_PORT,
# also /healthz and /readyz); Compose sets both.
