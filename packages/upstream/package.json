{
  "name": "@aiops/upstream",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The upstream read path shared by api and worker: binding lookup, credentials, adapter call, reader port.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "dependencies": {
    "@aiops/config": "workspace:*",
    "@aiops/connector-sdk": "workspace:*",
    "@aiops/core": "workspace:*"
  }
}
