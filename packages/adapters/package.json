{
  "name": "@aiops/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Upstream adapters (MCP upstream, OpenAPI). Depend on the connector SDK only.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "devDependencies": {
    "@aiops/testing": "workspace:*"
  },
  "dependencies": {
    "@aiops/connector-sdk": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
