    "test": "vitest run --project unit --passWithNoTests"
  },
  "devDependencies": {},
  "dependencies": {
    "@aiops/core": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "jose": "6.2.17",
    "testcontainers": "12.2.1"
  }
}
