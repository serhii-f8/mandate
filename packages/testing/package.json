{
  "name": "@aiops/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared test fakes and fixtures.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
