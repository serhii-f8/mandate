{
  "name": "@mandate/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL persistence: Drizzle schema, SQL migrations, migrator and repository implementations.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@mandate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@mandate/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "dependencies": {
    "@mandate/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
