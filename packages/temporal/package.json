{
  "name": "@aiops/temporal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Temporal glue shared by api and worker: the workflow contract, the encrypting payload codec and the data converters.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "@aiops/source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "dependencies": {
    "@aiops/core": "workspace:*",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/proto": "1.25.0"
  }
}
