{
  "name": "@aiops/widgets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React views built as MCP Apps widgets and as trusted-page parts.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "@aiops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:widgets",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:widgets": "WIDGET=changeset vite build -c vite.widget.config.ts && WIDGET=approval vite build -c vite.widget.config.ts && node scripts/check-bundles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
