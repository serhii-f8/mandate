{
  "name": "aiops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Operations Layer: self-hosted MCP server with policy, change-sets, approvals and audit",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "ci": "bash scripts/ci.sh",
    "aiops-config": "node packages/config/dist/cli.js",
    "aiops": "node apps/api/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
