{
  "name": "@mandate/magento2-catalog",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Curated operations and manifests for Magento 2 catalog content.",
  "license": "Apache-2.0",
  "mandate": {
    "preset": "preset.yaml",
    "sdk": "^1.1.0"
  },
  "exports": {
    ".": {
      "@mandate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "preset.yaml",
    "spec",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "record": "node scripts/record.mjs"
  },
  "devDependencies": {
    "@mandate/adapters": "workspace:*",
    "@mandate/config": "workspace:*",
    "@mandate/connector-sdk": "workspace:*",
    "@mandate/testing": "workspace:*"
  }
}
